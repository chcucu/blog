---
import Icon from './Icon.astro';
import PostCover from './PostCover.astro';
import { categories, categoryLabel, languageLabel } from '../data/taxonomy';
import { formatDate, postUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
  index?: number;
}

const { post, index } = Astro.props;
const category = categories[post.data.category];
const url = postUrl(post);
---

<article class="post-card">
  <div class="post-card__media">
    <PostCover post={post} index={index} />
    <a class="post-card__badge" data-tone={category.tone} href={`/categories/${post.data.category}/`}>
      {categoryLabel(post.data.category)}
    </a>
  </div>

  <div class="post-card__body">
    <h3 class="post-card__title">
      <a href={url}>{post.data.title}</a>
    </h3>
    <p class="post-card__desc">{post.data.description}</p>
    <div class="post-card__foot">
      <time datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date, post.data.lang)}
      </time>
      <span class="post-card__dot" aria-hidden="true">·</span>
      <span>{languageLabel(post.data.lang)}</span>
      <span class="post-card__arrow" aria-hidden="true">
        <Icon name="arrow-right" size={15} />
      </span>
    </div>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper-raised);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .post-card:hover {
    transform: translateY(-3px);
    border-color: var(--blue);
    box-shadow: var(--shadow-lift);
  }

  .post-card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: 1px solid var(--rule-soft);
  }

  .post-card:hover :global(.cover),
  .post-card:hover :global(.cover-image) {
    transform: scale(1.035);
  }

  .post-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.24rem 0.6rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-raised);
    color: var(--ink-2);
    font-size: 0.68rem;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(20, 36, 58, 0.08);
  }

  .post-card__badge::before {
    content: '';
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--blue);
  }

  .post-card__badge[data-tone='sage']::before {
    background: var(--sage);
  }

  .post-card__badge[data-tone='clay']::before {
    background: var(--clay);
  }

  .post-card__badge[data-tone='sand']::before {
    background: var(--sand);
  }

  .post-card__badge:hover {
    border-color: var(--blue);
    color: var(--blue-strong);
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
    padding: 1.05rem 1.1rem 1.15rem;
  }

  .post-card__title {
    font-size: clamp(1.1rem, 1.7vw, 1.3rem);
    line-height: 1.32;
  }

  .post-card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .post-card__title a:focus-visible {
    outline: none;
  }

  .post-card__title a:focus-visible::after {
    outline: 2px solid var(--blue);
    outline-offset: -4px;
  }

  .post-card:hover .post-card__title a {
    color: var(--blue-strong);
  }

  .post-card__desc {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--ink-3);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .post-card__foot {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--rule-soft);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .post-card__dot {
    opacity: 0.5;
  }

  .post-card__arrow {
    display: inline-flex;
    margin-left: auto;
    transition: transform 0.3s var(--ease), color 0.3s var(--ease);
  }

  .post-card:hover .post-card__arrow {
    transform: translateX(3px);
    color: var(--blue-strong);
  }
</style>
