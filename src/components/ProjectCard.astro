---
import Icon from './Icon.astro';
import { projectUrl, type Project } from '../lib/posts';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const url = projectUrl(project);
const tones = ['blue', 'sage', 'clay', 'sand'] as const;
const tone = tones[(project.data.order - 1) % tones.length] ?? 'blue';
const glyph = project.data.title.slice(0, 1);
---

<article class="project-card">
  <div class="project-card__cover" data-tone={tone} aria-hidden="true">
    <span class="project-card__glyph">{glyph}</span>
    <span class="project-card__year">{project.data.year}</span>
    <span class="project-card__status">{project.data.status}</span>
  </div>

  <div class="project-card__body">
    <h3 class="project-card__title">
      <a href={url}>{project.data.title}</a>
    </h3>
    {project.data.description && (
      <p class="project-card__desc">{project.data.description}</p>
    )}

    <ul class="project-card__stack" aria-label="技术栈">
      {project.data.stack.map((item) => <li>{item}</li>)}
    </ul>

    <div class="project-card__foot">
      <span class="project-card__more">
        查看项目
        <Icon name="arrow-right" size={15} />
      </span>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--paper-raised);
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: var(--blue);
    box-shadow: var(--shadow-lift);
  }

  .project-card__cover {
    position: relative;
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 10;
    padding: 1.15rem 1.3rem;
    overflow: hidden;
    background: var(--band-bg);
    border-bottom: 1px solid var(--rule-soft);
  }

  .project-card__cover[data-tone='blue'] {
    --band-bg: var(--blue-wash);
    --band-ink: var(--blue-strong);
  }

  .project-card__cover[data-tone='sage'] {
    --band-bg: var(--sage-wash);
    --band-ink: var(--sage);
  }

  .project-card__cover[data-tone='clay'] {
    --band-bg: var(--clay-wash);
    --band-ink: var(--clay);
  }

  .project-card__cover[data-tone='sand'] {
    --band-bg: var(--sand-wash);
    --band-ink: var(--sand);
  }

  .project-card__glyph {
    position: absolute;
    top: -0.2em;
    right: 0.02em;
    font-family: var(--font-display);
    font-size: clamp(7rem, 13vw, 11rem);
    line-height: 0.8;
    color: var(--band-ink);
    opacity: 0.12;
    pointer-events: none;
  }

  .project-card__year {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 2.1rem;
    line-height: 1;
    color: var(--band-ink);
  }

  .project-card__status {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1;
    padding: 0.14rem 0.55rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.04em;
    color: var(--band-ink);
    opacity: 0.85;
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    padding: 1.15rem 1.3rem 1.2rem;
  }

  .project-card__title {
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    line-height: 1.25;
  }

  .project-card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .project-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .project-card__title a:focus-visible {
    outline: none;
  }

  .project-card__title a:focus-visible::after {
    outline: 2px solid var(--blue);
    outline-offset: -4px;
  }

  .project-card:hover .project-card__title a {
    color: var(--blue-strong);
  }

  .project-card__desc {
    color: var(--ink-3);
    font-size: 0.86rem;
    line-height: 1.72;
  }

  .project-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .project-card__stack li {
    padding: 0.08rem 0.42rem;
    background: var(--blue-wash);
    color: var(--blue-strong);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }

  .project-card__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--rule-soft);
  }

  .project-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    transition: color 0.3s var(--ease);
  }

  .project-card:hover .project-card__more {
    color: var(--blue-strong);
  }
</style>
