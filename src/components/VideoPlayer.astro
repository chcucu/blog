---
import Icon from './Icon.astro';
---

<dialog class="video-player" data-video-player aria-label="视频预览">
  <div class="video-player__box">
    <div class="video-player__bar">
      <span class="video-player__dot" aria-hidden="true"></span>
      <p class="video-player__title" data-video-title>视频预览</p>
      <button type="button" class="video-player__close" data-video-close aria-label="关闭预览">
        <Icon name="close" size={16} />
      </button>
    </div>
    <div class="video-player__frame">
      <iframe
        data-video-frame
        title="Bilibili 视频播放器"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
    <div class="video-player__foot">
      <span>视频来源：Bilibili</span>
      <a data-video-link href="https://www.bilibili.com/" target="_blank" rel="noopener noreferrer">
        在 B 站打开
        <Icon name="external" size={14} />
      </a>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-video-player]');

  if (dialog) {
    const frame = dialog.querySelector<HTMLIFrameElement>('[data-video-frame]');
    const title = dialog.querySelector<HTMLElement>('[data-video-title]');
    const link = dialog.querySelector<HTMLAnchorElement>('[data-video-link]');

    const close = () => {
      dialog.close();
      if (frame) frame.src = 'about:blank';
    };

    document.querySelectorAll<HTMLButtonElement>('[data-video-preview]').forEach((button) => {
      button.addEventListener('click', () => {
        const bvid = button.dataset.bvid;
        if (!bvid || !frame) return;
        frame.src = `https://player.bilibili.com/player.html?bvid=${bvid}&autoplay=1&high_quality=1&danmaku=0`;
        if (title) title.textContent = button.dataset.title || '视频预览';
        if (link) link.href = `https://www.bilibili.com/video/${bvid}`;
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-video-close]')?.addEventListener('click', close);
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) close();
    });
  }
</script>

<style>
  .video-player {
    width: min(960px, 92vw);
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--paper-raised);
    color: var(--ink);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.28);
  }

  .video-player::backdrop {
    background: rgb(10 14 20 / 0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .video-player__bar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--rule-soft);
  }

  .video-player__dot {
    width: 0.66rem;
    height: 0.66rem;
    border-radius: 50%;
    background: #ff5f57;
    box-shadow: 1.1rem 0 0 #febc2e, 2.2rem 0 0 #28c840;
    margin-right: 1.7rem;
    flex-shrink: 0;
  }

  .video-player__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    font-size: 0.78rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .video-player__close {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--ink-2);
    background: var(--paper-sunk);
    cursor: pointer;
  }

  .video-player__close:hover {
    color: var(--ink);
    background: var(--rule-soft);
  }

  .video-player__frame {
    background: #000000;
  }

  .video-player__frame iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }

  .video-player__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.65rem 0.9rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .video-player__foot a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--blue-strong);
    text-decoration: none;
  }
</style>
