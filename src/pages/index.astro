---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import { categoryLabel } from '../data/taxonomy';
import {
  categoryCounts,
  getPosts,
  getProjects,
} from '../lib/posts';
import { site } from '../site.config';

const posts = await getPosts();
const projects = await getProjects();

const featured = posts.find((post) => post.data.featured) ?? posts[0];
const gridPosts = posts.filter((post) => post.id !== featured?.id).slice(0, 6);
const cats = categoryCounts(posts);
const zhCount = posts.filter((post) => post.data.lang === 'zh').length;
const enCount = posts.length - zhCount;
const issue = String(posts.length).padStart(2, '0');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  alternateName: site.nameEn,
  url: site.url,
  description: site.description,
  inLanguage: 'zh-CN',
  author: {
    '@type': 'Person',
    name: site.author,
    alternateName: site.handle,
    url: site.url,
    description: site.descriptionEn,
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <section class="masthead">
    <span class="masthead__ghost" aria-hidden="true">碎</span>
    <div class="container">
      <p class="kicker">Paper Scraps · Issue {issue}</p>
      <h1 class="masthead__title">把想法，<em>剪成纸片</em>。</h1>
      <form class="journal-search" action="/search/" method="get" role="search">
        <label class="visually-hidden" for="home-search">搜索文章</label>
        <span class="journal-search__icon" aria-hidden="true">
          <Icon name="search" size={18} />
        </span>
        <input
          id="home-search"
          type="search"
          name="q"
          placeholder="搜索文章、标签或关键词…"
          autocomplete="off"
        />
        <button type="submit" aria-label="搜索">
          <Icon name="arrow-right" size={17} />
        </button>
      </form>

      <nav class="entry-grid" aria-label="站点入口">
        <a class="entry-card" href="/about/">
          <span class="entry-card__top">
            <span class="entry-card__index">01</span>
            <span class="entry-card__label">Profile</span>
          </span>
          <span class="entry-card__title">查看个人信息</span>
          <span class="entry-card__arrow" aria-hidden="true">
            <Icon name="arrow-right" size={16} />
          </span>
        </a>

        <a class="entry-card" href="/projects/">
          <span class="entry-card__top">
            <span class="entry-card__index">02</span>
            <span class="entry-card__label">Projects</span>
          </span>
          <span class="entry-card__title">查看项目</span>
          <span class="entry-card__meta">{projects.length} 个在做的东西</span>
          <span class="entry-card__arrow" aria-hidden="true">
            <Icon name="arrow-right" size={16} />
          </span>
        </a>

        <a class="entry-card" href="/blog/">
          <span class="entry-card__top">
            <span class="entry-card__index">03</span>
            <span class="entry-card__label">Writing</span>
          </span>
          <span class="entry-card__title">阅读文章</span>
          <span class="entry-card__meta">{posts.length} 篇 · 中文 {zhCount} / EN {enCount}</span>
          <span class="entry-card__arrow" aria-hidden="true">
            <Icon name="arrow-right" size={16} />
          </span>
        </a>
      </nav>

      <nav class="pill-nav masthead__pills" aria-label="内容分类">
        <a class="pill" href="/blog/">全部 <span class="pill__count">{posts.length}</span></a>
        {
          cats.map((cat) => (
            <a class="pill" href={`/categories/${cat.key}/`}>
              {categoryLabel(cat.key)}
              <span class="pill__count">{cat.count}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    featured && (
      <section class="container home-featured" aria-label="精选文章">
        <FeaturedPost post={featured} />
      </section>
    )
  }

  {
    gridPosts.length > 0 && (
      <section class="container journal-section" aria-labelledby="latest-title">
        <div class="journal-meta">
          <h2 id="latest-title" class="journal-meta__title">最新纸片</h2>
          <span class="journal-meta__note">按时间叠放 · 共 {posts.length} 篇</span>
        </div>

        <div class="post-grid">
          {gridPosts.map((post, index) => <PostCard post={post} index={index + 1} />)}
        </div>

        <div class="journal-foot">
          <a class="btn btn--ghost" href="/blog/">
            查看全部 {posts.length} 篇
            <Icon name="arrow-right" size={15} />
          </a>
        </div>
      </section>
    )
  }

  <section class="container more-section" aria-label="项目">
    <div class="more-col">
      <div class="more-head">
        <h2>在做的事</h2>
        <a class="arrow-link" href="/projects/">
          全部项目
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
      <ul class="more-list">
        {
          projects.slice(0, 4).map((project) => (
            <li>
              <a href={`/projects/${project.id}/`}>
                <span class="more-list__year">{project.data.year}</span>
                <span class="more-list__title">{project.data.title}</span>
                <span class="more-list__meta">{project.data.status}</span>
                <span class="more-list__arrow" aria-hidden="true">
                  <Icon name="arrow-right" size={15} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .home-featured {
    margin-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }

  .entry-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 2.2rem auto 0;
    text-align: left;
  }

  .entry-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 2.2rem 0.2rem 0;
    border-top: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
  }

  .entry-card__top {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .entry-card__index {
    color: var(--clay);
  }

  .entry-card__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color 0.25s var(--ease);
  }

  .entry-card__meta {
    font-size: 0.76rem;
    color: var(--ink-2);
  }

  .entry-card__arrow {
    position: absolute;
    top: 1.45rem;
    right: 0;
    display: inline-flex;
    color: var(--ink-3);
    transition: transform 0.25s var(--ease), color 0.25s var(--ease);
  }

  .entry-card:hover .entry-card__title {
    color: var(--blue-strong);
  }

  .entry-card:hover .entry-card__arrow {
    transform: translateX(4px);
    color: var(--blue-strong);
  }

  .journal-section {
    padding-top: 0;
  }

  .more-section {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--rule-soft);
  }

  @media (max-width: 700px) {
    .masthead__pills {
      justify-content: flex-start;
    }

    .masthead__title {
      font-size: clamp(2.35rem, 11vw, 3.3rem);
    }

    .entry-grid {
      grid-template-columns: 1fr;
      gap: 0;
      margin-top: 1.7rem;
    }

    .entry-card {
      padding: 0.85rem 2.2rem 0.9rem 0;
    }

    .entry-card:last-child {
      padding-bottom: 0;
    }

    .entry-card__title {
      font-size: 1.12rem;
    }

    .entry-card__meta {
      font-size: 0.7rem;
    }

    .entry-card__arrow {
      top: 1.15rem;
    }
  }
</style>
