---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="页面走丢了" description="这个页面不存在，或者已经被移走了。" noIndex>
  <section class="not-found container">
    <div class="not-found__paper paper">
      <span class="not-found__code" aria-hidden="true">404</span>
      <p class="kicker">Page not found</p>
      <h1 class="not-found__title">这一页被风吹走了</h1>
      <p class="not-found__text">
        它可能被移到了别处，也可能从来没有存在过。
        你可以回到首页，或者去翻翻全部文章。
      </p>
      <div class="not-found__actions">
        <a class="btn" href="/">
          回到首页
          <Icon name="arrow-right" size={15} />
        </a>
        <a class="btn btn--ghost" href="/blog/">全部文章</a>
        <a class="btn btn--ghost" href="/search/">搜索</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    place-items: center;
    min-height: 60vh;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .not-found__paper {
    position: relative;
    max-width: 40rem;
    padding: clamp(2rem, 6vw, 4rem);
    text-align: center;
  }

  .not-found__code {
    position: absolute;
    top: -0.5rem;
    right: 1rem;
    font-family: var(--font-display);
    font-size: clamp(4rem, 12vw, 8rem);
    line-height: 1;
    color: var(--blue);
    opacity: 0.12;
    pointer-events: none;
  }

  .not-found__title {
    margin-top: 0.8rem;
    font-size: clamp(2rem, 5vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .not-found__text {
    max-width: 26rem;
    margin: 1rem auto 0;
    color: var(--ink-3);
    font-size: 0.94rem;
    line-height: 1.85;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 1.8rem;
  }
</style>
