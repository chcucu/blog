---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getLifeNotes } from '../lib/posts';
import { site } from '../site.config';

const notes = await getLifeNotes();
const rendered = await Promise.all(
  notes.map(async (note) => ({
    note,
    ...(await render(note)),
  })),
);

const kindLabels = {
  note: 'NOTE',
  photo: 'PHOTO',
  link: 'LINK',
} as const;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: '生活碎片',
  url: new URL('/life/', site.url).href,
  description: '不写代码的时候：路上的见闻、读过的书、拍糊的照片。',
};
---

<BaseLayout
  title="生活碎片"
  description="不写代码的时候：路上的见闻、读过的书、拍糊的照片。"
  jsonLd={jsonLd}
>
  <section class="page-head">
    <div class="container">
      <p class="kicker">Life · Scraps</p>
      <h1 class="page-head__title">生活碎片</h1>
      <p class="page-head__lede">
        不成体系的部分。一段路、一场雨、一本书，或者一句没头没尾的话。
        它们不解释什么，只是被留下来了。
      </p>
      <p class="page-head__meta">{notes.length} 张碎片 · 按时间叠放</p>
    </div>
  </section>

  <section class="container" aria-label="生活碎片列表">
    <div class="life-wall">
      {
        rendered.map(({ note, Content }, index) => (
          <article
            class:list={['life-card', 'paper', 'torn', 'scrap', { 'life-card--wide': index === 0 }]}
            data-tone={note.data.tone}
            style={`--tilt: ${index % 2 === 0 ? -0.35 : 0.35}deg`}
          >
            <header class="life-card__head">
              <div class="life-card__meta">
                <time datetime={note.data.date.toISOString()}>
                  {formatDate(note.data.date, 'zh')}
                </time>
                {note.data.location && (
                  <>
                    <span class="life-card__dot" aria-hidden="true"></span>
                    <span>{note.data.location}</span>
                  </>
                )}
              </div>
              <span class="life-card__kind">{kindLabels[note.data.kind]}</span>
            </header>

            <h2 class="life-card__title">{note.data.title}</h2>
            <p class="life-card__desc">{note.data.description}</p>

            <div class="life-card__body prose">
              <Content />
            </div>

            <span class="life-card__rule" aria-hidden="true"></span>
          </article>
        ))
      }
    </div>

    <p class="life-note">
      这些是示例碎片。想换成自己的内容，在 <code>src/content/life</code>
      里新增一个 Markdown 文件即可；照片可以直接放进 <code>public/uploads</code> 再引用。
    </p>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 4vw, 3rem);
  }

  .page-head__title {
    margin-top: 1rem;
    font-size: clamp(2.8rem, 7vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .page-head__lede {
    max-width: 36rem;
    margin-top: 1.3rem;
    color: var(--ink-3);
    font-size: 1rem;
    line-height: 1.85;
    text-wrap: pretty;
  }

  .page-head__meta {
    margin-top: 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .life-wall {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2rem);
    align-items: start;
  }

  .life-card {
    position: relative;
    padding: 1.5rem 1.6rem 1.8rem;
    overflow: hidden;
    filter: drop-shadow(0 12px 16px rgba(20, 36, 58, 0.07));
  }

  .life-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--note-wash, transparent);
    opacity: 0.6;
    pointer-events: none;
  }

  .life-card[data-tone='blue'] {
    --note-wash: var(--blue-wash);
  }

  .life-card[data-tone='clay'] {
    --note-wash: var(--clay-wash);
  }

  .life-card[data-tone='sage'] {
    --note-wash: var(--sage-wash);
  }

  .life-card[data-tone='sand'] {
    --note-wash: var(--sand-wash);
  }

  .life-card[data-tone='ink'] {
    --note-wash: var(--paper-sunk);
  }

  .life-card--wide {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    grid-template-areas:
      'head body'
      'title body'
      'desc body'
      'rule body';
    column-gap: clamp(1.5rem, 4vw, 3.5rem);
    padding: clamp(1.7rem, 4vw, 2.6rem);
  }

  .life-card--wide .life-card__head {
    grid-area: head;
  }

  .life-card--wide .life-card__title {
    grid-area: title;
    font-size: clamp(1.8rem, 3.4vw, 2.4rem);
    margin-top: 0.6rem;
  }

  .life-card--wide .life-card__desc {
    grid-area: desc;
  }

  .life-card--wide .life-card__body {
    grid-area: body;
    align-self: start;
    padding-left: clamp(1.5rem, 4vw, 3.5rem);
    border-left: 1px dashed var(--rule);
  }

  .life-card--wide .life-card__rule {
    display: none;
  }

  .life-card__head {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .life-card__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .life-card__dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }

  .life-card__kind {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    color: var(--ink-3);
    opacity: 0.7;
  }

  .life-card__title {
    margin-top: 0.7rem;
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
  }

  .life-card__desc {
    margin-top: 0.55rem;
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.75;
  }

  .life-card__body {
    margin-top: 1rem;
    color: var(--ink-3);
    font-size: 0.88rem;
    line-height: 1.85;
  }

  .life-card__body :global(p) {
    margin-top: 0.8em;
  }

  .life-card__body :global(p:first-child) {
    margin-top: 0;
  }

  .life-card__rule {
    display: block;
    width: 2.2rem;
    height: 2px;
    margin-top: 1.4rem;
    background: var(--ink-3);
    opacity: 0.3;
  }

  .life-note {
    max-width: 42rem;
    margin-top: 2rem;
    padding: 1rem 1.2rem;
    border-left: 2px solid var(--rule);
    color: var(--ink-3);
    font-size: 0.78rem;
    line-height: 1.8;
  }

  .life-note code {
    padding: 0.1em 0.3em;
    background: var(--paper-sunk);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  @media (max-width: 860px) {
    .life-wall {
      grid-template-columns: 1fr;
    }

    .life-card--wide {
      display: block;
    }

    .life-card--wide .life-card__body {
      padding-left: 0;
      border-left: 0;
    }

    .life-card--wide .life-card__rule {
      display: block;
    }
  }
</style>
