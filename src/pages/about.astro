---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getPosts, getProjects } from '../lib/posts';
import { site } from '../site.config';

const posts = await getPosts();
const projects = await getProjects();

const sameAs = site.socials
  .map((item) => item.href)
  .filter((href) => href.startsWith('http'));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.author,
  alternateName: site.handle,
  url: site.url,
  email: site.email,
  description: site.description,
  sameAs,
  knowsAbout: [
    'Minecraft',
    'Plugin Development',
    'Mod Development',
    'Web Development',
    'Photography',
    'Music',
    'Video',
  ],
};

const facets = [
  {
    key: 'Minecraft',
    title: '十年之约与 Paper 插件',
    text: '维护十年之约服务器，开发 Paper 插件与部分 Mod。',
  },
  {
    key: 'Web',
    title: '站点、工具与自动化',
    text: '使用 Astro、TypeScript 与 Cloudflare 构建站点和内部工具。',
  },
  {
    key: '摄影',
    title: '城市、光线与日常',
    text: '以城市街头、自然光与日常场景为主要拍摄题材。',
  },
  {
    key: '音乐',
    title: '编曲、录音与现场',
    text: '进行编曲、录音与现场演出相关的制作。',
  },
  {
    key: '影像',
    title: '拍摄、剪辑与叙事',
    text: '为服务器、旅行与音乐项目制作短片，涉及拍摄、剪辑与叙事。',
  },
  {
    key: '学生',
    title: '持续学习',
    text: '按优先级补充技术栈与基础知识。',
  },
];

const tones = ['blue', 'sage', 'clay', 'sand', 'blue', 'sage'] as const;

const colophon = [
  { label: '框架', value: 'Astro 7 · 静态生成' },
  { label: '部署', value: 'Cloudflare Pages' },
  { label: '字体', value: 'Fraunces · SF Pro / 系统字体 · SF Mono' },
  { label: '视觉', value: 'macOS 风格设计系统 · 浅色 / 深色' },
  { label: '内容', value: 'Markdown + Pages CMS' },
  { label: '评论', value: 'Giscus · GitHub Discussions' },
];
---

<BaseLayout
  title="关于"
  description={`关于 ${site.author}：十年之约服主、Paper 插件开发、Web、摄影、音乐与影像。`}
  jsonLd={jsonLd}
>
  <section class="profile">
    <div class="container">
      <div class="profile-card">
        <div class="profile-cover" aria-hidden="true">
          <span class="profile-cover__word">S</span>
          <span class="profile-cover__line">S.A · {site.handle}</span>
        </div>

        <div class="profile-main">
          <div class="profile-avatar-wrap">
            {
              site.avatar ? (
                <img
                  class="profile-avatar"
                  src={site.avatar}
                  alt={`${site.author} 的头像`}
                  width="460"
                  height="460"
                />
              ) : (
                <div class="profile-avatar profile-avatar--fallback" role="img" aria-label="头像占位">
                  <span aria-hidden="true">P</span>
                </div>
              )
            }
          </div>

          <div class="profile-info">
            <p class="kicker">Profile · {site.handle}</p>
            <h1 class="profile-name">{site.author}</h1>
            <p class="profile-handle">{site.handle} · {site.name}</p>
            <p class="profile-bio">
              十年之约服主，Paper 插件与 Mod 开发者，也做 Web、摄影、音乐与影像。
              关注长期运行的服务器、可维护的代码，以及把复杂信息整理成清晰页面的方法。
            </p>

            <div class="profile-actions">
              <a class="btn" href={`mailto:${site.email}`}>
                <Icon name="mail" size={16} />
                发送邮件
              </a>
              <a class="btn btn--ghost" href="/projects/">
                查看项目
                <Icon name="arrow-right" size={15} />
              </a>
            </div>
          </div>

          <dl class="profile-fields">
            <div>
              <dt>身份</dt>
              <dd>十年之约服主 · Paper 插件开发 · 学生</dd>
            </div>
            <div>
              <dt>在做</dt>
              <dd>十年之约、Bento、蓝色信笺、星河班</dd>
            </div>
            <div>
              <dt>方向</dt>
              <dd>Minecraft · Web · 摄影 · 音乐 · 影像</dd>
            </div>
            <div>
              <dt>邮箱</dt>
              <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
            <div>
              <dt>文章</dt>
              <dd>{posts.length} 篇</dd>
            </div>
            <div>
              <dt>项目</dt>
              <dd>{projects.length} 个</dd>
            </div>
          </dl>

          <ul class="profile-socials" aria-label="社交链接">
            {
              site.socials
                .filter((item) => item.icon !== 'rss')
                .map((item) => (
                  <li>
                    <a href={item.href} class="tag">
                      <Icon name={item.icon} size={14} />
                      {item.label}
                    </a>
                  </li>
                ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight container" aria-labelledby="now-title">
    <header class="section-head">
      <div>
        <p class="kicker">Now</p>
        <h2 id="now-title" class="section-head__title">最近在做什么</h2>
      </div>
    </header>

    <div class="now-grid">
      <article class="now-card">
        <span class="now-card__label">在开</span>
        <h3>十年之约</h3>
        <p>2024 年启动的长期原版生存服务器，支持 Java 与基岩版互通。</p>
      </article>
      <article class="now-card">
        <span class="now-card__label">在写</span>
        <h3>Paper 插件与 Bento</h3>
        <p>开发 Bento 菜单框架及若干服务器插件。</p>
      </article>
      <article class="now-card">
        <span class="now-card__label">在记录</span>
        <h3>摄影、音乐与影像</h3>
        <p>进行摄影与音乐制作，并为项目剪辑短片。</p>
      </article>
    </div>
  </section>

  <section class="section section--tight container" aria-labelledby="facets-title">
    <header class="section-head">
      <div>
        <p class="kicker">Facets</p>
        <h2 id="facets-title" class="section-head__title">专业方向</h2>
      </div>
    </header>

    <ul class="facets">
      {
        facets.map((item, index) => (
          <li class="facet" data-tone={tones[index % tones.length]}>
            <span class="facet__key">{item.key}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section section--tight container" aria-labelledby="colophon-title">
    <header class="section-head">
      <div>
        <p class="kicker">Colophon</p>
        <h2 id="colophon-title" class="section-head__title">技术实现</h2>
      </div>
    </header>

    <dl class="colophon">
      {
        colophon.map((item) => (
          <div class="colophon__row">
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="colophon__note">
      站点未使用前端框架运行时、大图首屏或第三方模板。
      界面由 CSS 构建，图表按需加载。
    </p>
  </section>

  <section class="section section--tight container" aria-labelledby="contact-title">
    <div class="contact paper">
      <p class="kicker">Contact</p>
      <h2 id="contact-title" class="contact__title">保持联系</h2>
      <p class="contact__text">
        邮件是最可靠的找到我的方式。也可以从下面这些地方看到我在做什么。
      </p>
      <a class="contact__mail" href={`mailto:${site.email}`}>{site.email}</a>
      <ul class="contact__socials">
        {
          site.socials.map((item) => (
            <li>
              <a href={item.href} class="tag">
                <Icon name={item.icon} size={14} />
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .profile {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
  }

  .profile-card {
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: var(--paper-raised);
  }

  .profile-cover {
    position: relative;
    height: clamp(7rem, 14vw, 10rem);
    overflow: hidden;
    border-bottom: 1px solid var(--rule-soft);
    background: linear-gradient(
      118deg,
      var(--blue-wash),
      var(--paper-sunk) 55%,
      var(--clay-wash)
    );
  }

  .profile-cover__word {
    position: absolute;
    top: -0.35em;
    right: 0.4rem;
    font-family: var(--font-display);
    font-size: clamp(9rem, 20vw, 15rem);
    line-height: 0.8;
    color: var(--blue-strong);
    opacity: 0.09;
    pointer-events: none;
  }

  .profile-cover__line {
    position: absolute;
    left: clamp(1.2rem, 4vw, 2.5rem);
    bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .profile-main {
    padding: 0 clamp(1.2rem, 4vw, 2.5rem) clamp(1.6rem, 4vw, 2.5rem);
  }

  .profile-avatar-wrap {
    margin-top: -3.4rem;
  }

  .profile-avatar {
    width: clamp(6.5rem, 12vw, 8.5rem);
    height: clamp(6.5rem, 12vw, 8.5rem);
    object-fit: cover;
    border: 4px solid var(--paper-raised);
    border-radius: 8px;
    background: var(--blue);
    box-shadow: var(--shadow);
  }

  .profile-avatar--fallback {
    display: grid;
    place-items: center;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 2.5rem;
  }

  .profile-info {
    margin-top: 1.1rem;
  }

  .profile-name {
    margin-top: 0.45rem;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .profile-handle {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--ink-3);
  }

  .profile-bio {
    max-width: 44rem;
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: 0.98rem;
    line-height: 1.9;
    text-wrap: pretty;
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.3rem;
  }

  .profile-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(1rem, 4vw, 2.5rem);
    margin: clamp(1.6rem, 3vw, 2.2rem) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule-soft);
  }

  .profile-fields > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0.1rem;
    border-bottom: 1px dashed var(--rule-soft);
  }

  .profile-fields dt {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .profile-fields dd {
    margin: 0;
    font-size: 0.84rem;
    text-align: right;
    color: var(--ink);
  }

  .profile-fields a {
    color: var(--blue-strong);
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }

  .profile-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.3rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 700px) {
    .profile-fields {
      grid-template-columns: 1fr;
    }

    .profile-avatar-wrap {
      margin-top: -2.6rem;
    }
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
  }

  .section-head__title {
    margin-top: 0.6rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.03em;
  }

  .now-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.6rem);
  }

  .now-card {
    padding: 1.4rem 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper-raised);
  }

  .now-card__label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    color: var(--blue-strong);
  }

  .now-card h3 {
    margin-top: 0.5rem;
    font-size: 1.25rem;
  }

  .now-card p {
    margin-top: 0.55rem;
    color: var(--ink-3);
    font-size: 0.85rem;
    line-height: 1.75;
  }

  .facets {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facet {
    padding: 1.3rem 1.4rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper-raised);
  }

  .facet__key {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--facet-ink);
  }

  .facet[data-tone='blue'] {
    --facet-ink: var(--blue-strong);
  }

  .facet[data-tone='sage'] {
    --facet-ink: var(--sage);
  }

  .facet[data-tone='clay'] {
    --facet-ink: var(--clay);
  }

  .facet[data-tone='sand'] {
    --facet-ink: var(--sand);
  }

  .facet h3 {
    margin-top: 0.5rem;
    font-size: 1.18rem;
  }

  .facet p {
    margin-top: 0.45rem;
    color: var(--ink-3);
    font-size: 0.84rem;
    line-height: 1.75;
  }

  .colophon {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--rule-soft);
  }

  .colophon__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0.3rem;
    border-bottom: 1px solid var(--rule-soft);
  }

  .colophon dt {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .colophon dd {
    margin: 0;
    font-size: 0.84rem;
    text-align: right;
  }

  .colophon__note {
    max-width: 40rem;
    margin-top: 1.2rem;
    color: var(--ink-3);
    font-size: 0.82rem;
    line-height: 1.85;
  }

  .contact {
    max-width: 44rem;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3.2rem);
  }

  .contact__title {
    margin-top: 0.7rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }

  .contact__text {
    margin-top: 0.8rem;
    color: var(--ink-3);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .contact__mail {
    display: inline-block;
    margin-top: 1.2rem;
    padding-bottom: 0.15rem;
    border-bottom: 1px solid var(--blue);
    color: var(--blue-strong);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    text-decoration: none;
  }

  .contact__mail:hover {
    color: var(--clay);
    border-color: var(--clay);
  }

  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 900px) {
    .now-grid {
      grid-template-columns: 1fr;
    }

    .facets {
      grid-template-columns: 1fr;
    }

    .colophon {
      grid-template-columns: 1fr;
    }
  }
</style>
